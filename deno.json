{
  "tasks": {
    "test": "deno test --allow-run --allow-read --allow-write --allow-env",
    "test:network": "MYINSTANTS_NETWORK=1 deno test --allow-run --allow-read --allow-write --allow-env --allow-net=www.myinstants.com,myinstants.com",
    "check": "deno check main.ts src/ test/ scripts/",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "package": "deno run --allow-read --allow-write --allow-env=RELEASE_TAG scripts/package.ts",
    "ci": "deno fmt --check && deno lint && deno check main.ts src/ test/ scripts/ && deno test --allow-run --allow-read --allow-write --allow-env"
  },
  "exclude": ["dist/"],
  "fmt": {
    "proseWrap": "preserve"
  },
  "lint": {
    "rules": { "tags": ["recommended"] }
  }
}
